{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pekral/pekral",
    "type": "project",
    "description": "Personal website",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.43.0",
        "laravel/tinker": "^3.2.0",
        "league/commonmark": "^2.10.7",
        "livewire/flux": "^2.22.0",
        "livewire/volt": "^1.11.2",
        "spatie/laravel-cookie-consent": "^3.5.0",
        "symfony/yaml": "^8.1.11",
        "pekral/arch-app-services": "dev-master",
        "spatie/laravel-data": "^4.23.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.15.0",
        "laravel/boost": "^2.10.4",
        "laravel/pail": "^1.3.0",
        "laravel/pint": "^1.32.3",
        "laravel/sail": "^1.71",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.6",
        "pekral/ai-olympus": "dev-master",
        "pekral/phpcs-rules": "^0.5",
        "pekral/rector-rules": "dev-master",
        "pekral/test-redundancy": "^0.2.6",
        "pestphp/pest": "^5.3.7",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-mockery": "^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@ai-olympus",
            "@php -d memory_limit=4G artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
      "ai-olympus": "vendor/bin/ai-olympus install --force --prune && rm -rf .agents",
      "analyse": "vendor/bin/phpstan analyse --memory-limit=4G",
      "build": "composer ai-olympus && composer fix && composer check",
      "check": "composer run phpcs-check && composer run pint-check && composer run rector-check && composer run analyse && composer run security-audit && composer run test:coverage && composer run test-redundancy-fast",
      "fix": "composer run rector-fix && composer run pint-fix && composer run phpcs-fix || true",
      "phpcs-check": "vendor/bin/phpcs --standard=ruleset.xml app/ tests/",
      "phpcs-fix": "vendor/bin/phpcbf --standard=ruleset.xml --no-cache app/ tests/ || true",
      "pint-check": "vendor/bin/pint app/ tests/ --test --parallel",
      "pint-fix": "rm -f storage/framework/cache/pint.cache && vendor/bin/pint app/ tests/ --parallel --cache-file=storage/framework/cache/pint.cache",
      "rector-check": "vendor/bin/rector process --dry-run",
      "rector-fix": "vendor/bin/rector process --clear-cache",
      "security-audit": "composer audit",
      "test-redundancy": "XDEBUG_MODE=off vendor/bin/test-redundancy",
      "test-redundancy-fast": "mkdir -p .test-redundancy && XDEBUG_MODE=off vendor/bin/test-redundancy analyse --base=origin/master > .test-redundancy/fast.json; status=$?; jq -r --arg root \"$PWD/\" -f build/test-redundancy-fast.jq .test-redundancy/fast.json && exit $status",
      "test:coverage": "php -dzend.assertions=1 -dpcov.enabled=1 -dpcov.directory=. -dxdebug.mode=off -dpcov.exclude=\"~vendor~\" vendor/bin/pest --coverage --min=100"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "ai-olympus": {
            "pr-gate": ["composer fix"],
            "fast-checks": ["composer test-redundancy-fast"]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pekral/ai-olympus": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.5.13"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
